rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // User profile + subcollections
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /pantry/{itemId} {
        allow read, write: if isOwner(uid);
      }

      match /savedRecipes/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      match /weeklyPlan/{weekId} {
        allow read, write: if isOwner(uid);
      }

      match /groceryList/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Global recipe archive: read by authenticated users, writes from server only
    match /recipeArchive/{recipeId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
