# Set secrets via Firebase Secret Manager, not this file.
# Run these commands once to register each secret:
#
#   firebase functions:secrets:set ANTHROPIC_API_KEY
#   firebase functions:secrets:set REPLICATE_API_KEY
#
# Each command will prompt you to enter the secret value.
# Secrets are automatically injected at runtime — never commit the actual values.

ANTHROPIC_API_KEY=
REPLICATE_API_KEY=
