rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Recipe images generated by Cloud Functions — public read, no client writes
    match /recipeImages/{imageId} {
      allow read;
      allow write: if false;
    }

    // Scan photos uploaded by the user
    match /scans/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
